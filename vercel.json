{
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/:path((?!api)(?!src)(?!assets)(?!@)(?!node_modules)(?!.*\\.).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "crons": [
    { "path": "/api/cron-reminders", "schedule": "* * * * *" },
    { "path": "/api/cron-community-guides", "schedule": "0 10,18 * * *" }
  ]
}
